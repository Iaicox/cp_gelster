{
  "name": "gelster-cp",
  "version": "0.1.0",
  "private": true,
  "description": "Gelster commercial proposal (KP) generator: static React build + minimal PHP API",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,client -c blue,green \"npm:dev:api\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:api": "php -S 127.0.0.1:8081 -t .",
    "build": "vite build && node scripts/copy-api.js",
    "start": "php -S ${HOST:-127.0.0.1}:${PORT:-8080} -t dist",
    "test": "vitest run",
    "test:php": "php tests/php/run.php",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
